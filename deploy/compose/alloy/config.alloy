// Local-only: tail every compose container's stdout into Loki with a
// service_name label, so the Grafana "Recent errors" panels have data.
// In Kubernetes this job is done by a Grafana Alloy / Promtail DaemonSet.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "svc" {
  targets = discovery.docker.containers.targets

  // /commerce-<service>-<n>  ->  service_name=<service>
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/commerce[-_](.+)[-_][0-9]+"
    target_label  = "service_name"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
  }
}

loki.source.docker "logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.svc.output
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
