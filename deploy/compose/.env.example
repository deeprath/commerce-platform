# Local-only defaults for the compose stack. NOT for any deployed environment.
COMPOSE_PROJECT_NAME=commerce

POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce
POSTGRES_DB=postgres

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Image tags — pinned so `task up` is reproducible.
PG_TAG=16
REDIS_TAG=7-alpine
KAFKA_TAG=3.9.0
SCHEMA_REGISTRY_TAG=7.7.0
OPENSEARCH_TAG=2.17.1
MINIO_TAG=RELEASE.2024-10-13T13-34-11Z
MC_TAG=RELEASE.2024-10-08T09-37-26Z
KEYCLOAK_TAG=26.0
OTELCOL_TAG=0.110.0
PROM_TAG=v2.55.0
LOKI_TAG=3.2.0
TEMPO_TAG=2.6.0
GRAFANA_TAG=11.3.0
CLICKHOUSE_TAG=24.8-alpine
ENVOY_TAG=v1.32-latest
# envoyproxy/ratelimit publishes no semver tags; "master" is the rolling build.
# Pin to a specific commit SHA tag before any non-local use.
RATELIMIT_TAG=master
ALLOY_TAG=v1.5.1
CURL_TAG=8.11.1
OPENFGA_TAG=v1.8.0
NGINX_TAG=1.27-alpine
NGINX_EXPORTER_TAG=1.4.0
