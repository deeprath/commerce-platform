# OpenFGA authorization model for order sharing (ReBAC).
#
# The source of truth is model.json (that's what the server ingests); this .fga
# DSL is the readable form kept alongside it. Keep them in sync.
#
#   model
#     schema 1.1
#
#   type user
#
#   type order
#     relations
#       # A viewer may read the order. The owner is NOT modelled here — ownership
#       # stays in the order DB (owner_id) and is checked there. FGA only ever
#       # adds delegated read access on top.
#       define viewer: [user]
